# ===================================================================
# dolaWeb2api-Camoufox (Dola International · Native Camoufox BiDi)
# Copy to .env and adjust as needed:
#   cp .env.example .env
# ===================================================================

# Server bind host & port (all DOLA_* vars also accept legacy DOUBAO_* names)
DOLA_PORT=9090
DOLA_HOST=127.0.0.1

# API Key (leave empty to disable auth; when set, send Authorization: Bearer <API_KEY>)
DOLA_API_KEY=

# Browser mode:
# - true (default): headless background worker (never auto-pops GUI windows; use /admin Web LiveView)
# - false: visible desktop Camoufox window for runtime worker
DOLA_HEADLESS=true

# Lazy start: true = do not start runtime Camoufox until first request (still never starts when 0 accounts exist)
DOLA_LAZY_START=false

# Account rotation strategy: failover (default) | round_robin
DOLA_ACCOUNT_STRATEGY=failover

# Optional path to pre-installed Camoufox binary (auto-downloads into ./runtime/camoufox if unset)
# CAMOUFOX_PATH=/path/to/camoufox

# Optional global default upstream proxy (per-account proxy in /admin overrides this)
# Supports http://, https://, socks5://, socks5h://, user:pass@host:port, host:port:user:pass, st5 host:port:user:pass
# Authenticated proxies automatically use the built-in LocalSocks5Relay
# DOLA_PROXY=socks5://user:pass@127.0.0.1:7890

# Camoufox Windows Firefox fingerprint locale & timezone
DOLA_LOCALE=en-US
DOLA_TIMEZONE=America/New_York

# Persistent isolated account pool & Camoufox profiles directory (<dir>/accounts/<account_id>/)
# DOLA_BROWSER_DATA=~/.dola_browser

# Rate limit (requests per minute) & timeout (seconds)
DOLA_RPM_LIMIT=30
DOLA_TIMEOUT=180

# Ephemeral conversations (true = auto-delete temporary Dola chats after response)
DOLA_AUTO_DELETE_CONV=true

# Default fallback model when client passes an unknown model name
DOLA_DEFAULT_MODEL=dola
